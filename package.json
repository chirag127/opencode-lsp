{
  "name": "opencode-lsp",
  "version": "0.1.0",
  "description": "Permission-aware stdio language servers for OpenCode V2",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.22.2" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test --test-reporter=tap --test-concurrency=1 --test-timeout=90000 test/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build",
    "pack:check": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2",
    "koffi": "3.3.8",
    "vscode-jsonrpc": "10.0.1",
    "vscode-languageserver-protocol": "3.18.6"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "6.0.3",
    "typescript-language-server": "6.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chirag127/opencode-lsp.git"
  }
}
